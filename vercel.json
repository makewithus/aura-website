{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "auraservice.info"
        }
      ],
      "destination": "https://auraservice.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.auraservice.info"
        }
      ],
      "destination": "https://auraservice.in/:path*",
      "permanent": true
    }
  ]
}

